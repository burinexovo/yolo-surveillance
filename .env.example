# ===========================
# LINE Messaging API
# ===========================
LINE_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# ===========================
# Cloudflare
# ===========================
CLOUDFLARE_ID=your_cloudflare_account_id
CLOUDFLARE_API=your_cloudflare_api_token

# ===========================
# Cloudflare R2
# ===========================
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=your_bucket_name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your_r2_public_domain.com

# ===========================
# Cloudflare KV (Optional)
# ===========================
# KV_USERS_NAMESPACE_ID=
# KV_USERS_PREFIX=
# KV_WATCH_TOKEN_NAMESPACE_ID=
# KV_WATCH_TOKEN_PREFIX=

# ===========================
# Cloudflare Workers
# ===========================
WORKERS_BASE_URL=https://your-worker.your-domain.workers.dev

# ===========================
# Video Inputs
# ===========================
DEVICE_CAMERA0=rtsp://admin:password@192.168.1.100:554/stream1

# Camera 1 (with YOLO detection)
CAMERA1_ID=cam1
CAMERA1_RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1
CAMERA1_HAS_YOLO=true

# Camera 2 (view only, optional)
# CAMERA2_ID=cam2
# CAMERA2_RTSP_URL=rtsp://admin:password@192.168.1.101:554/stream1
# CAMERA2_HAS_YOLO=false

# ===========================
# Shop Config
# ===========================
SHOP_CONFIG_PATH=config/shop.json

# ===========================
# Directories
# ===========================
VIDEO_SAVE_DIR=recordings
ASSETS_DIR=assets
SCREENSHOT_DIR=assets/screenshots
PHOTOS_DIR=assets/photos

# ===========================
# Notifications / Sound
# ===========================
AUDIO_ALERT_PATH=assets/sounds/alert.mp3

# ===========================
# User Config
# ===========================
USER_ID_FILE_PATH=config/users.json

# ===========================
# YOLO Models
# ===========================
YOLO11_MODEL_N_PATH=models/yolo11n.pt
YOLO11_MODEL_S_PATH=models/yolo11s.pt
# YOLO11_MODEL_M_PATH=models/yolo11m.pt
# YOLO11_MODEL_L_PATH=models/yolo11l.pt

# YOLO26_MODEL_N_PATH=models/yolo26n.pt
# YOLO26_MODEL_S_PATH=models/yolo26s.pt
# YOLO26_MODEL_M_PATH=models/yolo26m.pt
# YOLO26_MODEL_L_PATH=models/yolo26l.pt

# ===========================
# Trackers
# ===========================
TRACKER_BOTSORT_PATH=config/botsort.yaml
TRACKER_BYTETRACK_PATH=config/bytetrack.yaml

# ===========================
# Server
# ===========================
LOCAL_URL=http://localhost:8000
INTERNAL_TOKEN=your_internal_token
DEBUG=false

# ===========================
# WebRTC STUN/TURN
# ===========================
STUN_URL1=stun:stun.l.google.com:19302
STUN_URL2=stun:stun1.l.google.com:19302
# TURN_URL1=turn:your-turn-server.com:3478
# TURN_STATIC_AUTH_SECRET=your_turn_secret
# TURN_TTL_SEC_SERVER=3600
